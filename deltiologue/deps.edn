{:paths   ["src" "resources"]
 :deps    {org.clojure/clojure                 {:mvn/version "1.12.4"}

           ;; System config
           integrant/integrant                 {:mvn/version "1.0.1"}
           integrant/repl                      {:mvn/version "0.5.0"}
           aero/aero                           {:mvn/version "1.1.6"}

           ;; Server
           compojure/compojure                 {:mvn/version "1.7.2"}
           metosin/reitit                      {:mvn/version "0.10.0"}
           ring/ring                           {:mvn/version "1.15.3"}
           ring/ring-defaults                  {:mvn/version "0.7.0"}
           ring/ring-mock                      {:mvn/version "0.6.2"}

           ;; DB
           net.postgis/postgis-jdbc            {:mvn/version "2025.1.1"}
           com.zaxxer/HikariCP                 {:mvn/version "7.0.2"}
           com.github.seancorfield/next.jdbc   {:mvn/version "1.3.1086"}
           com.github.seancorfield/honeysql    {:mvn/version "2.7.1364"}
           migratus/migratus                   {:mvn/version "1.6.4"}
           camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.3"}

           ;; Auth
           buddy/buddy-auth                    {:mvn/version "3.0.323"}
           buddy/buddy-sign                    {:mvn/version "3.6.1-359"}

           ;; Logging
           org.slf4j/slf4j-nop                 {:mvn/version "2.0.17"}
           com.brunobonacci/mulog              {:mvn/version "0.10.0"}
           ring-logger/ring-logger             {:mvn/version "1.1.1"}

           ;; Util
           fipp/fipp                           {:mvn/version "0.6.29"}}
 :aliases {:run-m            {:main-opts ["-m" "rhinocratic.deltiologue" "dev"]}
           :dev              {:extra-paths ["dev"]}
           :create-migration {:ns-default rhinocratic.deltiologue.db.migrations
                              :exec-fn    create-migration}
           :migrate          {:ns-default rhinocratic.deltiologue.db.migrations
                              :exec-fn    migrate}
           :rollback         {:ns-default rhinocratic.deltiologue.db.migrations
                              :exec-fn    rollback}
           :up               {:ns-default rhinocratic.deltiologue.db.migrations
                              :exec-fn    up}
           :down             {:ns-default rhinocratic.deltiologue.db.migrations
                              :exec-fn    down}
           :build            {:deps       {io.github.clojure/tools.build {:git/tag "v0.10.12"
                                                                          :git/sha "97c5562"}}
                              :ns-default build}
           :test             {:extra-paths ["test"]
                              :extra-deps  {org.clojure/test.check               {:mvn/version "1.1.3"}
                                            io.github.cognitect-labs/test-runner {:git/tag "v0.5.1"
                                                                                  :git/sha "dfb30dd"}}}}}
