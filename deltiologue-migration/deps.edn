{:paths   ["src" "resources"]
 :deps    {org.clojure/clojure                   {:mvn/version "1.12.3"}
           dk.ative/docjure                      {:mvn/version "1.21.0"}
           org.clojure/data.csv                  {:mvn/version "1.1.0"}
           camel-snake-kebab/camel-snake-kebab   {:mvn/version "0.4.3"}
           org.apache.poi/poi                    {:mvn/version "5.5.1"}

           ;; DB
           net.postgis/postgis-jdbc              {:mvn/version "2025.1.1"}
           com.zaxxer/HikariCP                   {:mvn/version "7.0.2"}
           com.github.seancorfield/next.jdbc     {:mvn/version "1.3.1002"}
           com.github.seancorfield/honeysql      {:mvn/version "2.7.1295"}
           org.postgresql/postgresql             {:mvn/version "42.7.5"}

           ;; System config
           integrant/integrant                   {:mvn/version "1.0.1"}
           aero/aero                             {:mvn/version "1.1.6"}

           ;; Logging
           org.apache.logging.log4j/log4j-bom    {:mvn/version "2.24.3"
                                                  :extension   "pom"}
           org.apache.logging.log4j/log4j-to-jul {:mvn/version "2.25.3"}}

 :aliases {:seed     {:ns-default rhinocratic.deltiologue-migration.load
                      :exec-fn    seed}
           :truncate {:ns-default rhinocratic.deltiologue-migration.load
                      :exec-fn    truncate}
           :images   {:ns-default rhinocratic.deltiologue-migration.load
                      :exec-fn    update-images}
           :volume   {:ns-default rhinocratic.deltiologue-migration.load
                      :exec-fn    recreate-volume}
           :build    {:deps       {io.github.clojure/tools.build {:git/tag "v0.10.8"
                                                                  :git/sha "2fdfd66"}}
                      :ns-default build}
           :test     {:extra-paths ["test"]
                      :extra-deps  {org.clojure/test.check               {:mvn/version "1.1.1"}
                                    io.github.cognitect-labs/test-runner {:git/tag "v0.5.1"
                                                                          :git/sha "dfb30dd"}}}}}
